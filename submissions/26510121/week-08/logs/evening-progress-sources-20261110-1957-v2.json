    {
      "id": "shop-book-reconciliation",
      "title": "Book 증가와 현금·재고",
      "queries": [
        {
          "id": "sales-refunds",
          "source": {
            "label": "공식 자산 변화와 로컬 정산 원장",
            "files": [
              "logs/peer-market-source-20261110T105742394569Z.json",
              "logs/peer-market-source-20261109T235759979196Z.json",
              ".market/r3.sqlite3"
            ],
            "sql": "SELECT id,ts,data FROM events WHERE kind=? AND ts>=? AND ts<=? ORDER BY ts,rowid",
            "filters": [
              "판매: kind=shop_settled, 오전 보드 시점 이후부터 현재 보드 cutoff까지",
              "환불: kind=public_broken, 우리 정산 unit에 연결되며 refunded>0, unit별 중복 제거"
            ],
            "metricDefinitions": [
              {
                "label": "Book 증가",
                "definition": "현재 공식 Book − 오전 공식 Book."
              },
              {
                "label": "관측 환불",
                "definition": "구간 중 원장에 반영된 우리 unit 환불액. 이전 구간 판매의 환불도 포함."
              }
            ],
            "caveats": [
              "매출총이익 88,655,022 − 관측 환불 10,582,399 − 공식 Book 증가 77,874,521 = 잔차 198,102입니다. 잔차 원인을 전부 보관료로 확정하지 않았습니다.",
              "현금·재고와 KV 자금 모델은 각각 기록된 조회 시각의 상태이며 과거 상태를 복원한 값이 아닙니다."
            ]
          },
          "columns": [
            "Book 증가",
            "판매",
            "원가 미만 판매",
            "관측 환불액",
