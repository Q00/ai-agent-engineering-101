ds": null, "smoothed_attempt_seconds": 60.0, "post_sale_breakage": {"same_shop_sku": {}, "same_product": {"paid": 300, "broken": 8, "refunded": 5, "mature_paid": 298, "early_broken": 0, "unrefunded_within_6h": 3}}, "post_sale_contribution_debit": 0.033317, "estimated_saved_per_attempt": 0.52464, "estimated_saved_per_minute": 0.52464, "purchase_risk_policy": {"required_warranty_hours": 0, "risk_adjusted_usable_saved_estimate": 0.874401, "current_official_saved_reference": 0.7362}}, "opening_offer_range": [20947, 25436]}], "score_contract": {"version": "round3-book-saved-v2", "ranking_version": "round3-patch3.6", "weights": {"saved": 0.5, "forum": 0.3, "deals": 0.1, "posts": 0.1}, "scales": {"saved": "percentile", "forum": "raw_rating_0_to_1", "deals": "percentile", "posts": "percentile"}, "definition": "Saved = sum of realized deal contributions / (deals+100), retroactive for all Round 3. A usable deal contributes min(1, (list-paid)/(list-unit_cost)): share of the shop margin saved. An unusable deal contributes -1, or 0 if refunded. Expensive goods get no extra weight. The seller unit cost is private; category cost references are estimates, never verified costs. Final Saved is the market value, not an average of quotes or estimated contributions. Keep checkout validity and settlement likelihood; do not skip issued orders merely to chase a rate.", "all_definition": "Buyer ALL = .5 Saved percentile + .3 raw forum rating (Wilson lower bound, 0..1) + .1 deals percentile + .1 posts percentile. Only forum uses its value directly. Paid dislike power is unit*(N-1)^2 in total, paying only increases in that total. The authoritative unit is inventory.dislike_power_unit; paid votes reduce shop cash and Book. New negative-author hourly fees are separate; paid power alone is not the whole voting cost. Counted votes require at least 50 settled deals and a different owner. Voting eligibility and fees remain enforced by the market; a posted note is not a paid vote.", "cost_reference_