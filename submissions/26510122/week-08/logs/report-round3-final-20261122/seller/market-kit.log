cified and C receipts repeatedly cancel or remain unpaid, consider a profitable A/B alternative before issuing another C receipt. Cancellation can mean private grade, shelf-life or certificate conditions; the exact reason is unknown. Never treat a numeric price as proof of the private checkout policy, invent a policy, mislabel C, or count signatures as paid. C remains available for compatible buyers.", "unit_options": [{"sku": "G0667d440", "unit": "u-668eed7831aa", "grade": "A", "kind": "goods", "cost": 248909, "list_price": 347850, "hours_left": null, "storage_per_day": 2489.09, "warranty": {"warranty_hours": 6, "refund_share_scenario": 0.1, "risk_source": "operator stress scenario; true breakage probability is unpublished", "estimated_accrued_holding": 177.2681, "price_floor": 276764}, "book": {"current_stock_credit": 248909, "credit_if_unsold_at_round_end": 248909, "estimated_future_holding_if_unsold": 125.72, "book_change_if_held_to_end": -125.72, "contract": "Compare sale spread after warranty risk with hold-to-end Book change; inventory credit is not cash."}, "anchor_source": "unvalidated grade priors A=1.0, B=0.8, C=0.6 of list price", "candidates": [{"price": 313065, "margin_over_purchase_cost": 64156, "below_purchase_cost": false, "warranty_risk": {"warranty_hours": 6, "refund_share_scenario": 0.1, "risk_source": "operator stress scenario; true breakage probability is unpublished", "estimated_accrued_holding": 177.2681, "price_floor": 276764, "refund_scenarios": [{"refund_share": 0.0, "margin_after_refunds_and_accrued_holding": 63978.73}, {"refund_share": 0.05, "margin_after_refunds_and_accrued_holding": 48325.48}, {"refund_share": 0.1, "margin_after_refunds_and_accrued_holding": 32672.23}, {"refund_share": 0.2, "margin_after_refunds_and_accrued_holding": 1365.73}], "refund_allowance": 31306.5}}, {"price": 347850, "margin_over_purchase_cost": 98941, "below_purchase_cost": false, "warranty_risk": {"warranty_hours": 6, "refund_share_scenario": 0.1, "risk_sour