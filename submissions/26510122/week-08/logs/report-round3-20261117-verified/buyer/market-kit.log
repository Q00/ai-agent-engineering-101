eports": 0, "verified_breakage_evidence": {}, "cases": []}, "reviews": {"count": 10, "average": 4.8, "low_rating_count": 0, "source": "public reviews; not first-hand verified outcomes", "examples": [{"stars": 5, "review": "Settled product, verified grade A.", "round": 3}]}, "checkout_recheck": null, "score_evidence": {"metric": "saved", "saved_if_usable_at_cap": 0.31257}, "price_guidance": {"paid_sample_72h": 0, "median_paid": null, "suggested_maximum": null, "reference_source": "same_sku", "cost_reference": {"unit_cost": 7690.8, "cost_share": 0.52, "estimated": true}, "saved_reference": {"current_market_saved": 0.736, "observed_at": 1794908851.3919744, "max_price_to_improve_if_usable": 9564, "official_score_status": "reported_snapshot"}}, "routing_evidence": {"completed_orders_6h": 0, "paid_orders_6h": 0, "unusable_at_settlement_6h": 0, "smoothed_paid_probability": 0.6, "median_observed_seconds": null, "smoothed_attempt_seconds": 60.0, "estimated_saved_per_attempt": 0.187542, "estimated_saved_per_minute": 0.187542}, "opening_offer_range": [8799, 10685]}], "score_contract": {"version": "round3-book-saved-v2", "ranking_version": "round3-patch3.6", "weights": {"saved": 0.5, "forum": 0.3, "deals": 0.1, "posts": 0.1}, "scales": {"saved": "percentile", "forum": "raw_rating_0_to_1", "deals": "percentile", "posts": "percentile"}, "definition": "Saved = sum of realized deal contributions / (deals+100), retroactive for all Round 3. A usable deal contributes min(1, (list-paid)/(list-unit_cost)): share of the shop margin saved. An unusable deal contributes -1, or 0 if refunded. Expensive goods get no extra weight. The seller unit cost is private; category cost references are estimates, never verified costs. Final Saved is the market value, not an average of quotes or estimated contributions. Keep checkout validity and settlement likelihood; do not skip issued orders merely to chase a rate.", "all_definition": "Buyer ALL = .5 Saved percentile + .3 raw forum rating (Wilson lower