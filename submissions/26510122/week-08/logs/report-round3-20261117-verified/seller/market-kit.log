oss_allowed": false, "hours_left": 380.70115627957716, "near_expiry_hours": 3, "reason": "protect_acquisition_cost_and_accrued_holding"}, "market_objective": {"exploration_epsilon": 0.3, "allocation_focus": "replenishment", "meta_version": "0ed2fe72f0f244229c87168d0f5c248b", "meta_status": "active", "phase": "final_day", "hours_to_end": 4.5081, "ends_at": 1794927540.0, "inventory_capital_share": 0.9, "target_capital_share": 0.65, "window_budget": 24000000, "rolling_exploration_budget": 28125000, "total_unit_limit": null, "window_max_units": 200, "quantity_policy": "No global stock-count ceiling. Per-SKU demand targets, pending stock, category limits, cash and exposure govern quantity.", "allow_new_skus": true, "allow_replenishment": true, "score_weights": {"book": 0.5, "revenue": 0.3, "stars": 0.2}, "score_unit": "each component is a market percentile, not a raw weighted sum", "score_version": "round3-book-saved-v2", "book_definition": "Book = cash balance - starting capital - bankruptcy injections + unsold inventory acquisition cost. Buying inventory at its paid cost is initially Book-neutral, not a profit or a score boost. Sale spread, holding costs, food spoilage and warranty refunds change Book. Stock credit persists at round end, but is not a cash buyback. Shop ALL components use percentiles, not raw currency and stars. Buyer forum rating uses its raw 0..1 value.", "terminal_policy": "Retained stock counts at acquisition cost; compare Book after spoilage, holding and refunds. No forced cash liquidation."}, "objective": "Accept, counter or reject. Use the tool's estimated profit at the offered price and comparable paid evidence. If near-expiry food is sold below the profit floor, treat it as limiting a loss. Consider purchase cost, grade, food expiry and goods storage, but do not treat purchase cost as an absolute floor for food already near expiry. A receipt counts only if checkout later settles. The buyer profile is a hypothesis; a new low offer is evidence against the tested price. Do not escalate mechanically. Value Book, settled revenue and honest buyer satisfaction. Compare sale proceeds after warranty risk with retained inventory Book credit, storage and spoilage. Do not force below-cost liquidation solely because the round is ending. Never relax the buyer's quality, expiry or signature requirements to create volume."}}
