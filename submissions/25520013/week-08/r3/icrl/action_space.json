{
 "_note": "icrl allowlist (DESIGN.md sec 4). {kind} expands to food and goods; by_kind overrides per kind. categories.* = any category in the 24 h market stats (or an existing override). max_step = absolute step, max_ratio = multiplicative step; with both, the larger move is allowed. buyer.max_shops tops out at 8 because policy.validate refuses more. An entry may override protocol / block_steps; otherwise its family's apply. Fixed keys are enforced in icrl/space.py, not here.",
 "families": {"price": {"protocol": "switchback", "block_steps": 3}, "buyer": {"protocol": "switchback", "block_steps": 3},
              "supply": {"protocol": "long", "block_steps": 9}, "structure": {"protocol": "long", "block_steps": 9}},
 "long_block_steps_range": [6, 18],
 "keys": [
  {"path": "defaults.{kind}.price_mult", "side": "shop", "family": "price", "type": "float", "min": 0.8, "max": 1.2, "max_step": 0.03},
  {"path": "defaults.{kind}.min_margin", "side": "shop", "family": "price", "type": "float", "min": 0.02, "max": 0.2, "max_step": 0.02},
  {"path": "defaults.{kind}.concession", "side": "shop", "family": "price", "type": "float", "min": 0.0, "max": 0.1, "max_step": 0.01},
  {"path": "defaults.{kind}.max_rounds", "side": "shop", "family": "price", "type": "int", "min": 2, "max": 8, "max_step": 1},
  {"path": "shop.ask_quantile", "side": "shop", "family": "price", "type": "enum", "values": ["p50", "p75"], "max_step": 1, "default": "p75"},
  {"path": "shop.max_spend_per_run", "side": "shop", "family": "supply", "type": "int", "min": 600000, "max": 3000000, "max_ratio": 1.5},
  {"path": "shop.max_unit_cost", "side": "shop", "family": "supply", "type": "int", "min": 300000, "max": 1200000, "max_ratio": 1.5},
  {"path": "shop.max_lines_per_run", "side": "shop", "family": "supply", "type": "int", "min": 6, "max": 20, "max_step": 2},
  {"path": "defaults.{kind}.stock_target", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 20, "max_step": 3, "max_ratio": 1.5},
  {"path": "defaults.{kind}.qty_per_buy", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 20, "max_step": 3, "max_ratio": 1.5},
  {"path": "defaults.{kind}.breadth_qty", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 4, "max_step": 1},
  {"path": "defaults.{kind}.skus_per_category", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 4, "max_step": 1, "default": 1},
  {"path": "categories.*.stock_target", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 20, "max_step": 3, "max_ratio": 1.5},
  {"path": "categories.*.qty_per_buy", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 20, "max_step": 3, "max_ratio": 1.5},
  {"path": "categories.*.breadth_qty", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 4, "max_step": 1},
  {"path": "categories.*.skus_per_category", "side": "shop", "family": "supply", "type": "int", "min": 1, "max": 4, "max_step": 1, "default": 1},
  {"path": "shop.restock_priority", "side": "shop", "family": "structure", "type": "list", "default": []},
  {"path": "buyer.defaults.{kind}.open_frac", "side": "buyer", "family": "buyer", "type": "float", "min": 0.4, "max": 0.7, "max_step": 0.05},
  {"path": "buyer.defaults.{kind}.max_pay_frac", "side": "buyer", "family": "buyer", "type": "float", "min": 0.7, "max": 0.95, "max_step": 0.03, "by_kind": {"food": {"max": 0.9}}},
  {"path": "buyer.defaults.{kind}.step_frac", "side": "buyer", "family": "buyer", "type": "float", "min": 0.03, "max": 0.12, "max_step": 0.02},
  {"path": "buyer.defaults.{kind}.accept_ask_frac", "side": "buyer", "family": "buyer", "type": "float", "min": 0.55, "max": 0.9, "max_step": 0.05, "default_from": "buyer.defaults.{kind}.max_pay_frac"},
  {"path": "buyer.defaults.{kind}.max_rounds", "side": "buyer", "family": "buyer", "type": "int", "min": 3, "max": 8, "max_step": 1},
  {"path": "buyer.max_shops", "side": "buyer", "family": "buyer", "type": "int", "min": 3, "max": 8, "max_step": 1},
  {"path": "buyer.defaults.food.accept.hours_margin", "side": "buyer", "family": "buyer", "type": "int", "min": 0, "max": 3, "max_step": 1}
 ]
}
