{
  "harness": "Claude Code 2.1.287 with Claude Opus 5.5 (claude -p --model claude-opus-5-5); seller, buyer and market_buyer",
  "seller": {
    "cmd": ".venv/bin/python seller_agent.py --config shop-round2.json --port {port} --sign-receipts"
  },
  "buyer": {
    "cmd": ".venv/bin/python buyer_agent.py --url {url} --item {item} --budget {budget}"
  },
  "market_buyer": {
    "cmd": ".venv/bin/python market_buyer.py --shops {shops} --item {item} --budget {budget}"
  },
  "challenges": {
    "1": {"cmd": ".venv/bin/python run_challenges.py --challenge 1"},
    "2": {"cmd": ".venv/bin/python run_challenges.py --challenge 2 --budget 450"}
  }
}
