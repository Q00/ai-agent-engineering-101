{
  "harness": "GroqCloud openai/gpt-oss-120b",
  "seller": {
    "cmd": "python seller.py --port {port}"
  },
  "buyer": {
    "cmd": "python buyer.py {url} {item} {budget}"
  },
  "market_buyer": {
    "cmd": "python market_buyer.py --shops {shops} --item {item} --budget {budget} --order {order}"
  },
  "restock": {
    "cmd": "python restock_v4.py --state {state}"
  },
  "review": {
    "cmd": "python review.py --deal {deal}"
  }
}
