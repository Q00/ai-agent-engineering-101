# Build from the repository root; compose.yaml supplies that context.
# Target: HP N36L, AMD Athlon II Neo (K10, family 16). It has SSE3 and SSE4a but no
# SSSE3, SSE4.1, SSE4.2 or AVX, so every native part must run on baseline x86-64.
FROM node:22-bookworm-slim AS node

# Same Python base and pinned wheels as the shop image (Dockerfile).
# Node.js is here only to run the Claude Code CLI for the hourly strategy call.
FROM python:3.12.11-slim-bookworm
# Last npm release with the Node.js CLI; newer ones run a native binary that
# fails with Illegal instruction on K10 (week-07 DEPLOY_NAS.md, N40L section).
ARG CLAUDE_CODE_VERSION=2.1.112

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gosu tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --user-group agent
# SHOP_HOME and STRATEGIST_HOME are the defaults for `python -m strategist health` too.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/agent \
    DISABLE_AUTOUPDATER=1 \
    SHOP_HOME=/shop \
    STRATEGIST_HOME=/data

COPY submissions/25622005/week-08/docker/requirements.txt /opt/deploy/requirements.txt
# Wheels only: a source build could pick up compiler flags for a newer build machine.
RUN pip install --no-cache-dir --root-user-action=ignore --only-binary=:all: \
        -r /opt/deploy/requirements.txt

# Only the node binary and the npm package; the npm link is recreated because
# copying it from the node stage would copy the target file instead of the link.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && node --version \
    && npm --version
# Do not pull native sharp modules (the strategist sends text only).
# Require cli.js so changing the version cannot silently restore the native binary.
RUN npm install --global --omit=optional "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && test -f /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js \
    && ln -sf /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js /usr/local/bin/claude \
    && claude --version \
    && npm cache clean --force

# Dockerfile.strategist.dockerignore lets through only the modules the strategist imports.
# strategy/SKILL.md is not copied: the strategist edits the shop's file under /shop/strategy.
# The unit tests use strategist/tests/fixture_SKILL.md instead.
COPY submissions/25622005/week-08/policy.py /opt/strategist/policy.py
COPY submissions/25622005/week-08/model/ /opt/strategist/model/
COPY submissions/25622005/week-08/memory/ /opt/strategist/memory/
COPY submissions/25622005/week-08/strategist/ /opt/strategist/strategist/
COPY submissions/25622005/week-08/docker/strategist-entrypoint.sh /opt/deploy/strategist-entrypoint.sh
WORKDIR /opt/strategist
# Catch argument-parser and unit test failures before publishing an image.
RUN python -m strategist --help > /dev/null \
    && python -m unittest discover -s strategist/tests -t /opt/strategist
RUN chmod 755 /opt/deploy/strategist-entrypoint.sh \
    && mkdir -p /data /home/agent \
    && chown agent:agent /data /home/agent

# The entrypoint fixes bind-mount ownership (never /shop), then drops to the configured user ID.
ENTRYPOINT ["/opt/deploy/strategist-entrypoint.sh"]
CMD []
