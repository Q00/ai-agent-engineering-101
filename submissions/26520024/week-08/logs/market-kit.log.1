23:39:37 [buyer] {"time": "2026-11-17T14:39:37.016770+00:00", "event": "http_response", "order": "o-bba061885e57", "sku": "G32bf9a8e", "status": 200, "raw": "{\"name\": \"Kiro Everyday: Groceries & Goods\", \"description\": \"Everyday groceries and goods. Every unit ships with the market's certificate and its true grade (goods: A new, B damaged box, C refurbished; food: share of shelf life left). Ask by SKU or by category (menu of up to 3); say how long food must last. Paid 6-hour warranty on goods.\", \"supportedInterfaces\": [{\"url\": \"https://badge-paintball-designed-higher.trycloudflare.com/a2a/0\", \"protocolBinding\": \"JSONRPC\", \"protocolVersion\": \"1.0\"}], \"version\": \"3.3.0\", \"capabilities\": {\"streaming\": false}, \"defaultInputModes\": [\"text/plain\"], \"defaultOutputModes\": [\"application/json\", \"text/plain\"], \"skills\": [{\"id\": \"buy\", \"name\": \"Buy a product\", \"description\": \"Name a product by its SKU or its name. We reply with the unit we would sell: its true grade, its shelf life left or its condition, and an asking price. Send a price as a number to negotiate; a deal ends in a signed receipt, paid through the market's ACP checkout. The current ask is in each reply's metadata (ask) and is the last number in its text.\", \"tags\": [\"groceries\", \"household goods\", \"negotiation\", \"signed receipt\"], \"examples\": [\"I want to buy \\ube44\\ube44\\uace0 \\ud3ec\\uae30\\ubc30\\ucd94\\uae40\\uce58 5kg x1\\uac1c (G29fc9227)\", \"14000\"]}, {\"id\": \"browse\", \"name\": \"Choose within a category\", \"description\": \"Name a category instead of a product (for example \\uae40\\uce58 or \\uce68\\uad6c). We offer up to 3 products of it across its prices, each with its grade, list price and ask. Say your budget and we offer only what an order of that size accepts (0.5 to 1.5 times its reference price). Reply with the SKU your order accepts, or send a price for the first.\", \"tags\": [\"category\", \"menu\"], \"examples\": [\"I w