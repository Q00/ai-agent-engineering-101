+def _amount(v):
+    return isinstance(v, (int, float)) and not isinstance(v, bool) and v == v and v not in (float("inf"),) and v >= 0
+
+
+def restock_due(inv, last_restock, now):
+    """A restock run starts RESTOCK_EVERY after the last one started, and once SUPPLY_AHEAD seconds before a supply
+    window opens: on 11/11 a run ended 56 s before the 13:00:18 window (too early for restock.py to send lines) and
+    the next one had its lines 16 s after it opened."""
+    if now - last_restock > RESTOCK_EVERY:
+        return True
+    r = inv.get("restock")
+    if not isinstance(r, dict) or r.get("open") is not False or not _amount(r.get("opens_at")):
+        return False
+    ahead = r["opens_at"] - SUPPLY_AHEAD
+    return ahead <= now < r["opens_at"] and last_restock < ahead
+
+
+def until_open(inv):
+    """Seconds to wait for a supply window that inventory says opens within a minute; 0 when it is open, further
+    away or unknown (the market's 429 answers then decide, as before)."""
+    r = inv.get("restock") if isinstance(inv, dict) else None
+    if not isinstance(r, dict) or r.get("open") is not False or not _amount(r.get("opens_at")):
+        return 0
+    left = r["opens_at"] - time.time()
+    return left + SUPPLY_MARGIN if 0 < left <= 60 else 0
+
+
+def supply_pause():
+    """Seconds until the next supply call may go: SUPPLY_EVERY after the last one the market took."""
+    last = _supply_last[0]
+    return 0 if last is None else max(0, last + SUPPLY_EVERY + SUPPLY_MARGIN - time.monotonic())
+
+
+def cash_ok(market, cash, b, balance):
+    """(send it, the balance read, why not). cash: the restock command's {"floor": the balance a buy may not go under,
+    "unit": {sku: the most one unit can cost}}. balance: what the last supply call answered, or None to read
+    /api/inventory now. A floor, a unit cost or a balance that cannot be read sends nothing: the command's own check is
+    up to ~200 s old by the last of its twenty lines, and a refund or a retry's wait moves the balance meanwhile."""
+    floor, units = cash.get("floor"), cash.get("unit")
+    unit = units.get(b.get("sku")) if isinstance(units, dict) else None
+    qty = b.get("qty")
+    if not _amount(floor) or not _amount(unit) or not isinstance(qty, int) or isinstance(qty, bool) or qty < 1:
+        return False, balance, "no cash floor or unit cost for this line"
+    if balance is None:
+        try:
+            r = market.call("GET", "/api/inventory", "shop")
+            balance = r.json().get("balance") if r.status_code == 200 else None
+        except (httpx.HTTPError, ValueError, AttributeError):
+            balance = None
+        if not _amount(balance):
+            return False, None, "the balance could not be read"
+    if balance - unit * qty < floor:
+        return False, balance, f"balance {balance} less {unit * qty:.0f} would be under the cash floor {floor}"
+    return True, balance, ""
