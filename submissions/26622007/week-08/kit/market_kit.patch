+        cap["retry_at"] = now + SELLER_CAP_RETRY
+        log(f"[kit] your seller did not exit {wait} s after TERM: left running (no kill), new talks welcome again")
+        return False
+    except OSError as e:
+        log(f"[kit] could not stop your seller: {e}")
+    drop_marker(cap, md)
+    if proc.poll() is None:
+        return False
+    n, within = SELLER_CAP_RESTARTS
+    cap["restarts"] = [t for t in cap.get("restarts", []) if now - t < within] + [now]
+    if len(cap["restarts"]) >= n:
