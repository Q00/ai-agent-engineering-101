{
  "harness": "market agents: HARNESS=openrouter, openai/gpt-6-luna on OpenRouter, response_format json_schema strict (OPENROUTER_API_KEY from the environment); meta_harness.py improves them",
  "seller": {
    "cmd": "HARNESS=openrouter python seller.py --port {port}"
  },
  "buyer": {
    "cmd": "HARNESS=openrouter python buyer.py --url {url} --item {item} --budget {budget}"
  },
  "market_buyer": {
    "cmd": "HARNESS=openrouter python market_buyer.py --shops {shops} --item {item} --budget {budget} --order {order}"
  },
  "restock": {
    "cmd": "HARNESS=openrouter python restock.py --state {state}"
  },
  "review": {
    "cmd": "python review.py --deal {deal}"
  }
}
