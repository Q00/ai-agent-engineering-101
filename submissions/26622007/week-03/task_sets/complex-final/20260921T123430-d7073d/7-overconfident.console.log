th bid, confidence (0-100), reason\nexpiration-time: reply now"}], "stream": false, "response_format": {"type": "json_schema", "json_schema": {"name": "contract_net_bid_v2", "strict": true, "schema": {"type": "object", "additionalProperties": false, "required": ["bid", "confidence", "reason"], "properties": {"bid": {"type": "boolean"}, "confidence": {"type": "number", "minimum": 0, "maximum": 100}, "reason": {"type": "string", "minLength": 1, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"}}}}}}}
