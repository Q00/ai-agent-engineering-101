{
  "max_depth": 5,
  "max_tasks": 10,
  "max_steps": 3,
  "max_calls": 60,
  "max_parallel": 3,
  "memory_top_k": 3,
  "memory_ttl_days": 7,
  "scope": "rag-vector-adoption",
  "transport": {
    "model": "deepseek/deepseek-v4.1-flash",
    "temperature": 0,
    "max_tokens": 3800,
    "response_format": {"type": "json_object"},
    "reasoning": {"enabled": false},
    "provider": {"allow_fallbacks": true, "require_parameters": true, "max_price": {"prompt": 0.3, "completion": 1.2}},
    "timeout_seconds": 45,
    "response_deadline_seconds": 90,
    "retry_delay_seconds": 1,
    "max_attempts": 2
  },
  "source_fetch": {"max_parallel": 3, "max_requests": 20, "timeout_seconds": 12, "max_bytes": 2000000},
  "search": {
    "engine": "exa",
    "max_results": 3,
    "max_total_results": 6,
    "max_uses": 2,
    "max_characters": 2200,
    "allowed_domains": ["github.com", "postgresql.org", "qdrant.tech"]
  }
}
