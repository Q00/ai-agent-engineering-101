                        ).encode()
                        key.public_key().verify(
                            base64.b64decode(signature, validate=True), canonical
                        )
                    else:
                        assert receipt["seller"] == "테스트 상점"
                        assert "sig_seller" not in receipt
                    assert isinstance(replay, dict)
                    assert "error" in replay
                    print(
                        json.dumps(
