        ) -> ChatCompletionMessage:
            name, arguments = next(replies)
            return ChatCompletionMessage.model_validate(
                {
                    "role": "assistant",
                    "content": None,
                    "tool_calls": [
                        {
                            "id": "offline",
                            "type": "function",
