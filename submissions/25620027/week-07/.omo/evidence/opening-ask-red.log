                    {"action": "quote", "sku": item, "price": reserve - 1, "reason": "Low"},
                ),
                (
                    "decide",
                    {"action": "quote", "sku": item, "price": accepted, "reason": "Valid"},
                ),
            ]
        )
        feedback: list[JsonValue] = []
    
        async def complete(
            _self: Harness,
            messages: list[ChatCompletionMessageParam],
