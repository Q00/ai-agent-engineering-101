                key.public_key().verify(base64.b64decode(receipt.sig_seller), receipt.canonical())
                assert isinstance(replay, dict)
                assert "error" in replay
                assert len(calls) == count_before_replay == 5
                assert PersistentSellerStore(database).restore() == ({}, {opened.id})
                print(json.dumps({"accepted": accepted, "replay": replay, "model_calls": len(calls)}))
    
