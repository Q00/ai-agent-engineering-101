# Copy to .env, then enter your key locally. Never commit .env.
AGENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Experiment model, shared by both harnesses.
AGENT_MODEL=gpt-5.6-luna
AGENT_REASONING_EFFORT=none

# Optional multi-provider meta-harness. Fill keys only in the private .env.
GEMINI_API_KEY=
UPSTAGE_API_KEY=
META_GPT_MODEL=gpt-5.6-luna
META_GEMINI_MODEL=gemini-3.8-flash
META_SOLAR_MODEL=solar-pro4
