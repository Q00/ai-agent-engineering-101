{
  "protocol": "acp",
  "version": "2026-04-17",
  "endpoint": "https://customs-whilst-thy-gate.trycloudflare.com/acp",
  "capabilities": {
    "services": [
      "checkout"
    ],
    "payment_methods": [
      "ap2-mandate"
    ]
  },
  "tools": [
    {
      "name": "create_checkout_session",
      "method": "POST",
      "path": "/checkout_sessions",
      "input": {
        "line_items": "[{id: item, quantity: 1}]",
        "receipt": "the receipt the shop signed over A2A"
      }
    },
    {
      "name": "get_checkout_session",
      "method": "GET",
      "path": "/checkout_sessions/{id}",
      "input": {}
    },
    {
      "name": "complete_checkout_session",
      "method": "POST",
      "path": "/checkout_sessions/{id}/complete",
      "input": {
        "payment_data": "{order, checkout_mandate, payment_mandate}"
      }
    },
    {
      "name": "cancel_checkout_session",
      "method": "POST",
      "path": "/checkout_sessions/{id}/cancel",
      "input": {}
    }
  ]
}
